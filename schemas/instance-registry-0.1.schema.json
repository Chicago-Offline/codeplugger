{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Chicago-Offline/codeplugger/main/schemas/instance-registry-0.1.schema.json",
  "title": "Codeplugger instance registry 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "instances"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": "0.1" },
    "instances": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": ["radio"],
        "properties": {
          "radio": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "profile": { "type": "string" },
          "label": { "type": "string" },
          "dmr_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16776415
          },
          "dmr_contact_name": { "type": "string", "minLength": 1 },
          "dmr_ids": {
            "type": "array",
            "description": "Multiple selectable DMR identities for this radio (e.g. a licensed ham ID vs. an unregistered family/simplex ID). Zones and assignments select one by 'key'; see profile schema 'dmr_id'.",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "id"],
              "properties": {
                "key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
                "id": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 16776415
                },
                "name": { "type": "string", "minLength": 1 }
              }
            }
          },
          "default_dmr_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$",
            "description": "Key from 'dmr_ids' used when a zone or assignment does not override the identity."
          },
          "owner": { "type": "string" },
          "case_serial": { "type": ["string", "null"] },
          "fcc_id": { "type": ["string", "null"] },
          "hardware_family": { "type": "string" },
          "firmware": { "type": ["string", "null"] },
          "sk_buttons": {
            "type": ["string", "null"]
          }
        },
        "additionalProperties": true
      }
    }
  }
}
