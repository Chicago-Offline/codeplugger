{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Chicago-Offline/codeplugger/main/schemas/profile-0.1.schema.json",
  "title": "Codeplugger Profile 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "name", "radio", "zones"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": "0.1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "radio": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "zones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "assignments"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "assignments": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}