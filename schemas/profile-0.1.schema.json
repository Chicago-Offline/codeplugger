{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Chicago-Offline/codeplugger/main/schemas/profile-0.1.schema.json",
  "title": "Codeplugger Profile 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "name", "radio", "zones"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": "0.1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "radio": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "radio_instance": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "extensions": { "$ref": "#/$defs/extensions" },
    "rx_groups": {
      "type": "array",
      "description": "DMR RX group lists. Members reference SSRF contact ids (talkgroup facts live in SSRF; grouping them is profile policy).",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "contacts"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "contacts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "scan_lists": {
      "type": "array",
      "description": "Scan lists. Members reference assignment ids that must also be selected in a zone, and expand to channels the same way zone assignments do.",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "channels"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "channels": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "zones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "assignments"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "assignments": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "oneOf": [
                { "type": "string", "minLength": 1 },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id"],
                  "anyOf": [
                    { "required": ["display_name"] },
                    { "required": ["extensions"] },
                    { "required": ["contact"] },
                    { "required": ["rx_group"] },
                    { "required": ["scan_list"] }
                  ],
                  "properties": {
                    "id": { "type": "string", "minLength": 1 },
                    "display_name": { "type": "string", "minLength": 1 },
                    "contact": { "type": "string", "minLength": 1 },
                    "rx_group": { "type": "string", "minLength": 1 },
                    "scan_list": { "type": "string", "minLength": 1 },
                    "extensions": { "$ref": "#/$defs/extensions" }
                  }
                }
              ]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "extensions": {
      "type": "object",
      "description": "Namespaced escape hatch for radio- or backend-specific settings the core schema does not model. Keys are namespaces (usually a radio or backend id); values are passed through to exporters unvalidated, mirroring qdmr's extension mechanism.",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9_]*$" },
      "additionalProperties": { "type": "object" }
    }
  }
}